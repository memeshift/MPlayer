# Composer
/vendor/
composer.phar

# Environment
.env
.env.*
!.env.example

# Logs & cache
*.log
.phpunit.result.cache
.php-cs-fixer.cache

# Admin login/upload — credentials, lockout state, audit log, staged
# uploads. Never committed even if a host forces these into the repo dir
# instead of one level above it (see config.php's CREDENTIALS_FILE).
.mplayer-admin-*.json
.mplayer-lock-*.json
.mplayer-audit.log
/staging/*
!/staging/.htaccess

# Claude Code — local context, never published
CLAUDE.md
.claude/

# OS & editors
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Per-install config — copied from config.example.php on first setup,
# never overwritten by an update. See README.
/config.php

# Admin-uploaded assets (backgrounds, site icons)
/images/backgrounds/
/images/icons/

# Uploaded tracks — the directory and its .htaccess ship (scan.php needs
# the directory to exist), the audio never does
/music/*
!/music/.htaccess
